{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ExecutionRequest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "authorization_id",
    "action",
    "resource_id",
    "payload_hex"
  ],
  "properties": {
    "authorization_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "action": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "resource_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "payload_hex": {
      "type": "string",
      "pattern": "^[0-9A-Fa-f]*$",
      "maxLength": 8192
    }
  }
}
